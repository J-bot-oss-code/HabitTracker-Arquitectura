# Copia este archivo como .env.local (ignorado por git) para cambiar la configuración.
# Nunca pongas credenciales aquí: todo lo que empieza por VITE_ termina en el bundle público.

# URL base del backend (Host/WebApi). Solo se usa cuando VITE_USE_MOCKS=false.
VITE_API_URL=http://localhost:5246

# true: la app usa la API simulada (MSW) con el mismo contrato que el backend.
# Por defecto: activa en `npm run dev` y en pruebas; desactivada en `npm run build`.
# false: llama al backend real (su CORS ya permite http://localhost:5173 y :5174, con credenciales).
VITE_USE_MOCKS=true

# ID de cliente de Google para "Continuar con Google" (termina en .apps.googleusercontent.com). Es público por diseño,
# pero no lo versiones: créalo en Google Cloud Console (README raíz › Inicio de sesión con Google). Debe ser el MISMO
# que usa el backend (Google:ClientId). Vacío = el botón queda desactivado. Reinicia `npm run dev` al cambiarlo.
VITE_GOOGLE_CLIENT_ID=
