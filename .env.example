# ============================================================================
# HabitTracker Nexus - variables de entorno del contenedor
#
# Uso:   copia este archivo a ".env" y ejecuta:   docker compose up --build
# El archivo ".env" NO se versiona (.gitignore). Estos valores son SOLO DE EJEMPLO
# para una demostración local: cámbialos antes de usar el proyecto en serio.
# Evita los caracteres  $  ;  =  y comillas dentro de los valores.
# ============================================================================

# --- Base de datos (SQL Server en el servicio "db"; no se publica al equipo) ---
# Debe cumplir la política de SQL Server: 8+ caracteres con mayúsculas, minúsculas, números y símbolos.
DB_PASSWORD=Ejemplo_Cambiar_123!

# --- Sesión (JWT) ---
# Clave de firma de los tokens: 32+ caracteres. Si la cambias, las sesiones abiertas dejan de ser válidas.
JWT_CLAVE=clave-de-ejemplo-solo-para-demostracion-cambiala-en-tu-entorno-0123456789

# --- Administrador inicial (se crea al arrancar si no existe) ---
ADMIN_CORREO=admin@ejemplo.com
# 12+ caracteres. Si es más corta, la aplicación se detiene al arrancar.
ADMIN_CLAVE=Ejemplo_Admin_2026!

# --- Correo ---
# "consola": los correos (enlace de activación, código de recuperación) se escriben en el log
# (docker compose logs webapi) en lugar de enviarse. Solo funciona si SMTP_HOST está VACÍO.
# Para enviar correos de verdad: rellena los cuatro SMTP_* (ejemplo: smtp.gmail.com / 587 / tu@correo.com / clave de aplicación).
CORREO_MODO=consola
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- API externa: OpenWeatherMap (clima) ---
# Clave gratuita en https://openweathermap.org/api . Con este valor de ejemplo la operación
# GET /api/habits/plan-del-dia responde un rechazo controlado (503) y el resto del proyecto sigue funcionando.
OPENWEATHER_API_KEY=pon_aqui_tu_clave_de_openweathermap

# --- Aplicación ---
# Dirección pública de la API; se usa para construir el enlace de activación de los correos.
APP_BASE_URL=http://localhost:8080
# Origen del frontend (CORS): solo esta dirección exacta puede llamar a la API desde el navegador.
FRONTEND_URL=http://localhost:5173
# Rechaza contraseñas que aparecen en filtraciones conocidas (Pwned Passwords, solo viaja un prefijo del hash).
# Si la consulta falla o tarda, la contraseña se permite. Ponlo en false para comprobar solo el formato.
CONTRASENAS_FILTRADAS=true
# ID de cliente de Google para "Continuar con Google" (termina en .apps.googleusercontent.com). No es un secreto, pero
# no lo versiones: créalo en Google Cloud Console. Vacío = el inicio con Google responde 503 y el resto funciona.
GOOGLE_CLIENT_ID=
# Baja de cuenta: días que se espera antes de borrar de verdad una cuenta cuya eliminación se pidió (se puede cancelar)
# y cada cuántos minutos el proceso en segundo plano busca cuentas cuyo plazo terminó.
DIAS_GRACIA_BAJA=30
BAJAS_INTERVALO_MINUTOS=1440
# Directorio de las claves de Data Protection que cifran el cuestionario de salud. docker compose usa /app/data/claves en el
# volumen dataprotection-claves. Respáldalo APARTE de la base de datos: si se pierden las claves, esos datos no se pueden
# leer, y si se filtran junto con la base, el cifrado no protege nada.
# (Fuera de Docker y fuera de Development es obligatorio; en Development se usa la carpeta del perfil del usuario.)
# DATAPROTECTION_KEYS_PATH=

# Muestra Swagger en /swagger. Útil para probar la API; ponlo en false fuera de una demostración.
SWAGGER_HABILITADO=true
