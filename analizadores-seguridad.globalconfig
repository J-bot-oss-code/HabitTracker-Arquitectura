is_global = true
# Mayor que el nivel por defecto (0) para que estas líneas ganen sobre la configuración del SDK.
global_level = 100

# Reglas de seguridad de los analizadores de .NET (categoría Security) [RD-05, RD-07, RD-10]:
# SQL dinámico (CA2100), deserialización insegura (CA2300-CA2362), inyección y XSS (CA3001-CA3147),
# XML/XXE (CA3075-CA3077) y criptografía débil o mal usada (CA5350-CA5405).
# Se enumeran por ID porque la severidad por categoría NO activa las reglas desactivadas por defecto
# (comprobado: con "category-Security" MD5.Create() no daba error; con el ID sí).
# Lista tomada de analysislevelsecurity_10_all.globalconfig del SDK 10.0.301. Al subir de SDK, regenerarla.

