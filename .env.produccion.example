# Plantilla del .env de PRODUCCIÓN (docker-compose.prod.yml). Cópiala a .env en el servidor y rellénala:
#   cp .env.produccion.example .env && chmod 600 .env
# NUNCA subas el .env real (RD-10). Aquí solo hay nombres; los valores van vacíos a propósito.
# Genera los secretos con un gestor de contraseñas o con: openssl rand -base64 48

# --- Dominio (el DNS debe apuntar a este servidor antes del primer arranque) ---
DOMINIO=

# --- Base de datos y sesión ---
# Contraseña del usuario sa de SQL Server: al menos 12 caracteres, con mayúsculas, minúsculas, números y símbolos.
DB_PASSWORD=
# Clave que firma los tokens: al menos 32 caracteres aleatorios.
JWT_CLAVE=

# --- Administrador inicial (se crea al arrancar por primera vez; cambia su contraseña al entrar) ---
ADMIN_CORREO=
# Al menos 12 caracteres.
ADMIN_CLAVE=

# --- Correo real (activación, recuperación, avisos). Gmail con "contraseña de aplicación" alcanza para el piloto (~500 al día) ---
SMTP_HOST=
SMTP_PORT=
SMTP_SSL=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Opcionales ---
# ID de cliente de Google (público, no es un secreto). Añade https://<DOMINIO> a los orígenes autorizados en Google Cloud.
GOOGLE_CLIENT_ID=
OPENWEATHER_API_KEY=
# Rechaza contraseñas filtradas (consulta anónima a Pwned Passwords). false = solo se comprueba el formato.
CONTRASENAS_FILTRADAS=
DIAS_GRACIA_BAJA=
BAJAS_INTERVALO_MINUTOS=
CORREO_ESPERA_REINTENTO_SEGUNDOS=
